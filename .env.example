# GEMINI_API_KEY: Optional/required for Gemini AI API calls.
# AI Studio automatically injects this at runtime if provided.
GEMINI_API_KEY=

# Default AI provider (gemini, local, offline)
AI_PROVIDER=gemini

# Configured AI model identifier (e.g. gemini-2.5-flash)
AI_MODEL=gemini-2.5-flash

# Maximum conversation history turns sent in context
MAX_CONTEXT_MESSAGES=20

# Backend Host & Port settings
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# App URL (injected by AI Studio Cloud Run)
APP_URL=

# Voice Engine & TTS Settings
VOICE_ENABLED=true
AUTO_SPEAK=false
VOICE_LANGUAGE=auto
TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=

# Notification Intelligence & Privacy Shield Settings (Phase 4)
NOTIFICATION_INTELLIGENCE_ENABLED=true
PRIORITY_APPS=calendar,slack,work,emergency,phone,dialer
PRIORITY_CONTACTS=boss,manager,mom,doctor,family,emergency
IMPORTANT_NOTIFICATION_SPEECH=true
NOTIFICATION_COOLDOWN_SECONDS=30
QUIET_HOURS_ENABLED=true
QUIET_HOURS_START=22:00
QUIET_HOURS_END=07:00
SENSITIVE_NOTIFICATION_PROTECTION=true

